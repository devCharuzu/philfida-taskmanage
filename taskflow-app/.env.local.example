# Copy to .env.local and fill in your own values — never commit .env.local
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Web Push — PUBLIC key only.
# The PRIVATE key belongs in Vercel env vars as VAPID_PRIVATE_KEY and must
# never carry the VITE_ prefix, or it ships to every browser.
VITE_VAPID_PUBLIC_KEY=
